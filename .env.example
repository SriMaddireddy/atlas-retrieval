# Copy to .env only if using an already-running local Ollama service.
# Never use a remote/cloud endpoint. No hosted model APIs are implemented.
OLLAMA_URL=http://127.0.0.1:11435
OLLAMA_MODEL=qwen2.5:1.5b
# Default source launch uses localhost:8092 and data/atlas.db.
# ATLAS_KEYS is a JSON mapping from 16+ character credentials to tenant slugs.
# ATLAS_READ_ONLY=1 rejects document changes (does not make SQLite read-only).
